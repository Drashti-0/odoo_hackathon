<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_login_signup_link" inherit_id="web.login" priority="30">
        <xpath expr="//form[hasclass('oe_login_form')]" position="after">
            <div class="bl-login-signup">
                <span>New to Brightloop?</span>
                <a href="/subscription/signup">Create a customer account</a>
            </div>
        </xpath>
    </template>

    <template id="portal_home_brightloop_links" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div class="o_portal_index_card col-12 col-md-6">
                <a href="/my/subscriptions" class="d-flex align-items-center gap-2 p-3 h-100 border rounded bg-white text-decoration-none">
                    <i class="fa fa-repeat fa-fw text-primary"/>
                    <span>My subscriptions</span>
                    <i class="fa fa-angle-right ms-auto"/>
                </a>
            </div>
            <div class="o_portal_index_card col-12 col-md-6">
                <a href="/my/subscription-invoices" class="d-flex align-items-center gap-2 p-3 h-100 border rounded bg-white text-decoration-none">
                    <i class="fa fa-file-text-o fa-fw text-primary"/>
                    <span>My invoices</span>
                    <i class="fa fa-angle-right ms-auto"/>
                </a>
            </div>
        </xpath>
    </template>

    <template id="portal_signup" name="Brightloop Customer Registration">
        <t t-call="website.layout">
            <main id="wrap" class="bl-portal-shell">
                <section class="bl-auth-card">
                    <a class="bl-brand" href="/">Brightloop <span>Software</span></a>
                    <p class="bl-eyebrow">CUSTOMER ACCOUNT</p>
                    <h1>Create your account</h1>
                    <p class="bl-muted">Register to access your subscription contracts and invoices.</p>
                    <div t-if="error" class="alert alert-danger" role="alert">
                        <t t-esc="error"/>
                    </div>
                    <form action="/subscription/signup" method="post" class="bl-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label for="bl_name">Full name</label>
                        <input id="bl_name" name="name" type="text" required="required"
                               autocomplete="name" t-att-value="values.get('name', '')"/>
                        <label for="bl_email">Email address</label>
                        <input id="bl_email" name="email" type="email" required="required"
                               autocomplete="email" t-att-value="values.get('email', '')"/>
                        <label for="bl_company">Company <span class="bl-muted">(optional)</span></label>
                        <input id="bl_company" name="company_name" type="text"
                               autocomplete="organization" t-att-value="values.get('company_name', '')"/>
                        <label for="bl_password">Password</label>
                        <input id="bl_password" name="password" type="password" required="required"
                               minlength="9" autocomplete="new-password"/>
                        <p class="bl-hint">At least 9 characters, including uppercase, lowercase, and a special character.</p>
                        <button class="btn bl-primary-btn" type="submit">Create account</button>
                    </form>
                    <p class="bl-auth-switch">Already registered? <a href="/web/login">Sign in</a></p>
                </section>
            </main>
        </t>
    </template>

    <template id="portal_subscriptions" name="My Brightloop Subscriptions">
        <t t-call="portal.portal_layout">
            <t t-set="title">My subscriptions</t>
            <main class="bl-portal-shell bl-portal-wide">
                <header class="bl-page-heading">
                    <div>
                        <p class="bl-eyebrow">CUSTOMER PORTAL</p>
                        <h1>My subscriptions</h1>
                        <p class="bl-muted">Review your plans, contract status, and recurring amount.</p>
                    </div>
                    <a class="bl-secondary-btn" href="/my/subscription-invoices">View invoices</a>
                </header>
                <div class="bl-table-wrap">
                    <table class="table bl-table">
                        <thead>
                            <tr>
                                <th>Contract</th><th>Plan</th><th>Status</th>
                                <th>Start date</th><th>Next billing</th><th class="text-end">Recurring total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="subscriptions" t-as="subscription">
                                <td><strong t-esc="subscription.name"/></td>
                                <td t-esc="subscription.plan_id.name"/>
                                <td><span class="bl-status" t-esc="subscription.state"/></td>
                                <td t-esc="subscription.start_date or '-'"/>
                                <td t-esc="subscription.next_billing_date or '-'"/>
                                <td class="text-end">
                                    <span t-field="subscription.amount_total"
                                          t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/>
                                </td>
                            </tr>
                            <tr t-if="not subscriptions">
                                <td colspan="6" class="bl-empty">No subscriptions are linked to your account yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <nav class="bl-portal-links">
                    <a href="/my">Portal home</a>
                    <a href="/my/subscription-invoices">My invoices</a>
                </nav>
            </main>
        </t>
    </template>

    <template id="portal_subscription_invoices" name="My Brightloop Invoices">
        <t t-call="portal.portal_layout">
            <t t-set="title">My invoices</t>
            <main class="bl-portal-shell bl-portal-wide">
                <header class="bl-page-heading">
                    <div>
                        <p class="bl-eyebrow">CUSTOMER PORTAL</p>
                        <h1>My invoices</h1>
                        <p class="bl-muted">View invoice totals, due dates, and payment status.</p>
                    </div>
                    <a class="bl-secondary-btn" href="/my/subscriptions">View subscriptions</a>
                </header>
                <div class="bl-table-wrap">
                    <table class="table bl-table">
                        <thead>
                            <tr>
                                <th>Invoice</th><th>Invoice date</th><th>Due date</th>
                                <th>Payment status</th><th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="invoices" t-as="invoice">
                                <td><strong t-esc="invoice.name"/></td>
                                <td t-esc="invoice.invoice_date or '-'"/>
                                <td t-esc="invoice.due_date or '-'"/>
                                <td><span class="bl-status" t-esc="invoice.payment_state"/></td>
                                <td class="text-end">
                                    <span t-field="invoice.amount_total"
                                          t-options="{'widget': 'monetary', 'display_currency': invoice.currency_id}"/>
                                </td>
                            </tr>
                            <tr t-if="not invoices">
                                <td colspan="5" class="bl-empty">No invoices are linked to your account yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <nav class="bl-portal-links">
                    <a href="/my">Portal home</a>
                    <a href="/my/subscriptions">My subscriptions</a>
                </nav>
            </main>
        </t>
    </template>
</odoo>
