<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Quotation Sequence: SQ-00001 -->
        <record id="seq_subscription_quotation" model="ir.sequence">
            <field name="name">Subscription Quotation Sequence</field>
            <field name="code">subscription.quotation</field>
            <field name="prefix">SQ-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Confirmed Subscription Sequence: SUB-00001 -->
        <record id="seq_subscription_subscription" model="ir.sequence">
            <field name="name">Subscription Contract Sequence</field>
            <field name="code">subscription.subscription</field>
            <field name="prefix">SUB-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Subscription Plan Code Sequence -->
        <record id="seq_subscription_plan" model="ir.sequence">
            <field name="name">Subscription Plan Sequence</field>
            <field name="code">subscription.plan</field>
            <field name="prefix">PLAN-</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Subscription Invoice Sequence: INV-00001 -->
        <record id="seq_subscription_invoice" model="ir.sequence">
            <field name="name">Subscription Invoice Sequence</field>
            <field name="code">subscription.invoice</field>
            <field name="prefix">INV-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
