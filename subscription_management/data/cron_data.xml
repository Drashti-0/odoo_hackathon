<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Intelligent Automated Recurring Billing Engine Cron -->
        <record id="ir_cron_subscription_recurring_billing" model="ir.cron">
            <field name="name">Subscription: Intelligent Automated Recurring Billing Engine</field>
            <field name="model_id" ref="model_subscription_subscription"/>
            <field name="state">code</field>
            <field name="code">model.cron_recurring_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Automated Contract Expiry Check Cron -->
        <record id="ir_cron_subscription_expiry_check" model="ir.cron">
            <field name="name">Subscription: Contract Expiry &amp; Auto-Close Monitor</field>
            <field name="model_id" ref="model_subscription_subscription"/>
            <field name="state">code</field>
            <field name="code">model.action_check_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_subscription_billing_notifications" model="ir.cron">
            <field name="name">Subscription: Upcoming Billing Notifications</field>
            <field name="model_id" ref="model_subscription_subscription"/>
            <field name="state">code</field>
            <field name="code">model.cron_billing_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
