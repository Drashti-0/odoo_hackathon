<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- CUSTOMER DATA ISOLATION: RECORD RULES          -->
        <!-- ============================================== -->

        <!-- Portal Customer Rule: Read Own Subscription Lines -->
        <record id="subscription_line_portal_rule" model="ir.rule">
            <field name="name">Portal Customer Own Subscription Lines</field>
            <field name="model_id" ref="model_subscription_line"/>
            <field name="domain_force">[('subscription_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_subscription_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal Customer Rule: Read Own Invoice Lines -->
        <record id="subscription_invoice_line_portal_rule" model="ir.rule">
            <field name="name">Portal Customer Own Invoice Lines</field>
            <field name="model_id" ref="model_subscription_invoice_line"/>
            <field name="domain_force">[('invoice_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_subscription_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal Customer Rule: Read Own Payment Receipts -->
        <record id="subscription_payment_portal_rule" model="ir.rule">
            <field name="name">Portal Customer Own Payments</field>
            <field name="model_id" ref="model_subscription_payment"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_subscription_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Staff Access Rule: Full read/write within assigned company -->
        <record id="subscription_line_staff_rule" model="ir.rule">
            <field name="name">Staff Multi-Company Subscription Lines</field>
            <field name="model_id" ref="model_subscription_line"/>
            <field name="domain_force">['|', ('subscription_id.company_id', '=', False), ('subscription_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_subscription_user'))]"/>
        </record>

    </data>
</odoo>
